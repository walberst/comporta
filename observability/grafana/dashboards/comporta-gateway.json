{
  "title": "Comporta - Gateway",
  "uid": "comporta-gateway",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Requisicoes por segundo",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(comporta_requests_total[1m]))",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 2,
      "title": "Taxa de erro (4xx/5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(comporta_requests_total{status=~\"4..|5..\"}[1m])) / sum(rate(comporta_requests_total[1m]))",
          "legendFormat": "taxa de erro"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latencia p95 por rota",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(comporta_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Rejeicoes por rate limit",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(comporta_rate_limit_rejections_total[1m])) by (partner)",
          "legendFormat": "{{partner}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Clientes conectados no websocket de metricas",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "comporta_ws_clients_connected",
          "legendFormat": "clientes"
        }
      ]
    },
    {
      "id": 6,
      "title": "Falhas de autenticacao",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(comporta_auth_failures_total[5m]))",
          "legendFormat": "falhas/s"
        }
      ]
    },
    {
      "id": 7,
      "title": "Erros de upstream",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(comporta_upstream_errors_total[5m]))",
          "legendFormat": "erros/s"
        }
      ]
    }
  ]
}
